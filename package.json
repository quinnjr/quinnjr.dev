{
  "name": "quinnjr.dev",
  "version": "2.3.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "prisma generate",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --code-coverage --watch=false",
    "test:server": "vitest run --config vitest.config.server.mjs",
    "test:server:watch": "vitest --config vitest.config.server.mjs",
    "test:server:coverage": "vitest run --config vitest.config.server.mjs --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:all": "pnpm test:server && pnpm test && pnpm test:e2e",
    "serve:ssr:quinnjr.dev": "node dist/quinnjr.dev/server/server.mjs",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"**/*.{ts,html,css,scss,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,html,css,scss,json,md}\"",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:reset": "prisma migrate reset",
    "user:create": "tsx scripts/create-user.ts",
    "prepare": "husky",
    "schema:print": "tsx scripts/print-schema.ts",
    "codegen": "pnpm schema:print && graphql-codegen --config codegen.ts"
  },
  "private": true,
  "license": "MIT",
  "dependencies": {
    "@angular/animations": "^21.2.10",
    "@angular/common": "^21.2.10",
    "@angular/compiler": "^21.2.10",
    "@angular/core": "^21.2.10",
    "@angular/forms": "^21.2.10",
    "@angular/platform-browser": "^21.2.10",
    "@angular/platform-browser-dynamic": "^21.2.10",
    "@angular/platform-server": "^21.2.10",
    "@angular/router": "^21.2.10",
    "@angular/ssr": "^21.2.8",
    "@apollo/client": "^4.2.2",
    "@node-rs/argon2": "^2.0.2",
    "@pothos/core": "^4.12.0",
    "@pothos/plugin-prisma": "^4.14.3",
    "@pothos/plugin-scope-auth": "^4.1.6",
    "@prisma/client": "^6.17.1",
    "apollo-angular": "^14.0.0",
    "express": "^4.18.2",
    "graphql": "^16.14.1",
    "graphql-yoga": "^5.21.1",
    "jose": "^6.2.3",
    "ngx-quill": "^28.0.1",
    "postprocessing": "^6.38.3",
    "prisma": "^6.17.1",
    "quill": "^2.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.0",
    "slugify": "^1.6.6",
    "three": "^0.183.2",
    "tslib": "^2.3.0",
    "tsyringe": "^4.10.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.8",
    "@angular/cli": "^21.2.8",
    "@angular/compiler-cli": "^21.2.10",
    "@graphql-codegen/cli": "^7.1.2",
    "@graphql-codegen/client-preset": "^6.0.1",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-codegen/typescript-apollo-angular": "^5.0.1",
    "@graphql-codegen/typescript-operations": "^6.0.3",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.0",
    "@types/three": "^0.183.1",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^4.0.8",
    "angular-eslint": "19.0.2",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^62.0.0",
    "flowbite": "^2.5.2",
    "husky": "^9.1.7",
    "jasmine-core": "~5.1.0",
    "jest": "^30.2.0",
    "jest-preset-angular": "^15.0.3",
    "jsdom": "^27.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "playwright": "^1.56.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.19.0",
    "unplugin-sri": "^0.0.11",
    "vitest": "^3.2.4"
  }
}
