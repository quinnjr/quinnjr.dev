# Get the current branch name
current_branch=$(git symbolic-ref --short HEAD 2>/dev/null)

# Prevent pushing directly to a long-lived branch — everything goes via a PR.
#
# `develop` is included. It used to be exempt, on the grounds that back-merges
# from main are pushed here directly — but that exemption is what let release
# commits, version bumps and one-line fixes land on develop without review,
# which is precisely what .cursor/rules/git-flow-workflow.mdc says must not
# happen ("Protected branch - no direct commits or pushes"). A back-merge is a
# PR like anything else: branch it, push the branch, open the PR.
#
# This mirrors the server-side `pull_request` rule on both branches, so the
# failure is local and immediate rather than a rejected push after the tests
# have already run.
if [ "$current_branch" = "main" ] || [ "$current_branch" = "master" ] || [ "$current_branch" = "develop" ]; then
  echo "❌ You cannot push directly to '$current_branch' branch!"
  echo ""
  echo "git-flow: open a pull request from a feature/, bugfix/, release/ or"
  echo "hotfix/ branch instead."
  echo ""
  echo "  feature/*, bugfix/*  ->  develop"
  echo "  release/*, hotfix/*  ->  main, then back-merge to develop"
  echo ""
  exit 1
fi

# Enforce git-flow branch naming convention
# Valid patterns:
# - feature/name
# - bugfix/name
# - hotfix/name
# - release/name
# - develop (protected, but valid)
# - main/master (protected, but valid)

if ! echo "$current_branch" | grep -qE "^(feature|bugfix|hotfix|release|develop|main|master)(/.*)?$"; then
  echo "❌ Invalid branch name: '$current_branch'"
  echo ""
  echo "Branch names must follow git-flow convention:"
  echo "  - feature/name (for new features)"
  echo "  - bugfix/name (for bug fixes)"
  echo "  - hotfix/name (for critical hotfixes)"
  echo "  - release/name (for release branches)"
  echo ""
  echo "Examples:"
  echo "  feature/user-authentication"
  echo "  bugfix/login-redirect"
  echo "  hotfix/security-patch"
  echo "  release/v2.0.0"
  echo ""
  exit 1
fi

echo "✅ Branch name is valid: $current_branch"

echo ""
echo "🧪 Running unit tests before push (server + Angular; e2e runs in CI)..."
echo "🔧 Generating Prisma client..."
pnpm prisma:generate || exit 1

echo "🔍 Running linter..."
pnpm lint || exit 1

echo "🧪 Running server tests..."
pnpm test:server || {
  echo ""
  echo "❌ Server tests failed! Cannot push to remote."
  echo "Please fix all test failures before pushing."
  exit 1
}

echo "🧪 Running Angular unit tests..."
pnpm test --watch=false || {
  echo ""
  echo "❌ Angular unit tests failed! Cannot push to remote."
  echo "Please fix all test failures before pushing."
  exit 1
}

echo "✅ Lint and unit tests passed! Proceeding with push..."

