commit_msg=$(cat "$1")

# Conventional Commits format: type(scope)!: description
# https://www.conventionalcommits.org/
# Examples:
#   feat: add user authentication
#   fix(auth): correct login redirect
#   feat!: remove deprecated API
#   chore: update dependencies

if ! echo "$commit_msg" | grep -qE "^(feat|fix|feature|bugfix|release|hotfix|chore|docs|style|refactor|test|perf|build|ci|revert)(\([^)]+\))?!?: .+"; then
  echo "❌ Invalid commit message format!"
  echo ""
  echo "Commit message must follow Conventional Commits format:"
  echo "  <type>[(scope)][!]: <description>"
  echo ""
  echo "Valid types: feat, fix, chore, docs, style, refactor, test, perf,"
  echo "             build, ci, revert, release, hotfix"
  echo ""
  echo "Examples:"
  echo "  feat: add user authentication"
  echo "  fix(auth): correct login redirect"
  echo "  feat!: remove deprecated v1 API"
  echo "  chore: update dependencies"
  echo ""
  exit 1
fi

echo "✅ Commit message format is valid"

