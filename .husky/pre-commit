echo "🔧 Generating Prisma client..."
pnpm prisma:generate || exit 1

# Format ONLY the staged files and re-stage the result. `pnpm format` rewrote
# the whole working tree AFTER git had snapshotted the index, so the commit
# could still contain unformatted code while this hook reported success — and
# the developer got surprise unstaged diffs across the repo.
echo "💅 Formatting staged files..."
pnpm exec lint-staged || {
  echo ""
  echo "❌ Formatting failed!"
  exit 1
}

echo "🔍 Running linter..."
pnpm lint || {
  echo ""
  echo "❌ Linting failed!"
  echo "Please fix linting errors before committing."
  echo "Run 'pnpm lint:fix' to auto-fix some issues."
  exit 1
}

echo "🧪 Running server tests..."
pnpm test:server || {
  echo ""
  echo "❌ Server tests failed!"
  echo "Please fix test failures before committing."
  exit 1
}

# Deliberately fast: only the server suite runs here. The Angular unit suite
# runs on pre-push; e2e runs in CI.
echo "✅ Pre-commit checks passed (staged-file format, lint, server tests)."
